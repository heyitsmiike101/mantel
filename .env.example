# ---------------------------------------------------------------------------
# Family Calendar configuration. Copy to .env and edit:  cp .env.example .env
# Every value here is optional -- the app runs with none of them set, as a
# purely local calendar. Google settings are only needed for calendar sync.
# ---------------------------------------------------------------------------

# Port the app is served on (host side).
PORT=8080

# The URL family members type into a browser to reach this app. It MUST match
# what you register as the authorized redirect URI in Google Cloud, exactly.
# Examples: http://localhost:8080  |  http://192.168.1.50:8080  |  http://calendar.local:8080
PUBLIC_BASE_URL=http://localhost:8080

# Encrypts stored Google tokens and signs OAuth state. Generate your own with:
#   docker run --rm python:3.12-slim sh -c "pip -q install cryptography && python -c 'from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())'"
# Changing this invalidates all linked Google accounts (they just re-link).
SECRET_KEY=dev-insecure-change-me

# --- Google Calendar sync (optional) ---------------------------------------
# Full walkthrough: docs/setup-google-oauth.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Sync tuning -----------------------------------------------------------
# How often to pull changes from Google, in seconds.
SYNC_INTERVAL_SECONDS=300
# How often to push local changes to Google, in seconds.
PUSH_INTERVAL_SECONDS=15
# How far back to import events on first sync, in days.
SYNC_PAST_DAYS=90
# Set to false to pause all Google syncing without unlinking accounts.
SYNC_ENABLED=true

# --- Database --------------------------------------------------------------
# SQLite (default) is right for a family. It uses WAL mode, so many screens can
# read at once while someone is editing. Point at Postgres only if you need it:
#   DATABASE_URL=postgresql+psycopg://user:pass@host:5432/familycalendar
DATABASE_URL=sqlite:////data/family.db

# Comma-separated allowed CORS origins for external tools. "*" is fine on a LAN.
CORS_ORIGINS=*
