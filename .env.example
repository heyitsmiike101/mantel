# ---------------------------------------------------------------------------
# Family Calendar. Copy to .env and edit:  cp .env.example .env
#
# There are only two things here you might want to change, and you set them
# once when you first build the container. EVERYTHING ELSE -- Google Calendar,
# weather, the screensaver, Home Assistant -- is configured in the app itself,
# under Settings, with instructions on each page. You should never need to come
# back to this file.
# ---------------------------------------------------------------------------

# Port the app is served on.
PORT=8080

# Encrypts stored Google tokens and your Google client secret, and signs the
# OAuth handshake. Generate your own -- any random string works, it is hashed
# into a key:
#   openssl rand -base64 32
#
# Keep it. Changing it means every family member reconnects their Google
# account once, and your calendar subscription links change.
SECRET_KEY=dev-insecure-change-me


# ---------------------------------------------------------------------------
# Everything below is optional and has a sensible default. Most people can
# delete this whole section.
# ---------------------------------------------------------------------------

# SQLite is right for a family: it runs in WAL mode, so every screen can read
# while somebody is editing. Point this at Postgres only if you really need to.
#   DATABASE_URL=postgresql+psycopg://user:pass@host:5432/familycalendar
DATABASE_URL=sqlite:////data/family.db

# How often to pull changes from Google, and how often to retry a failed push.
SYNC_INTERVAL_SECONDS=300
PUSH_INTERVAL_SECONDS=15

# How far back to import events the first time a calendar syncs, in days.
SYNC_PAST_DAYS=90

# Set to false to pause Google syncing without unlinking anyone.
SYNC_ENABLED=true

# Which origins may call the API from a browser. "*" is fine on a home network.
CORS_ORIGINS=*

# --- Google Calendar: configure this in Settings → Google, not here ---------
# These are read once on first start and copied into the app's own settings,
# so an installation that predates the Settings screen keeps working. New
# installs should leave them empty and use Settings → Google, which walks you
# through creating them and shows the exact redirect URI to give Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_BASE_URL=
